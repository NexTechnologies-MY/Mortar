{
  "name": "mortar",
  "version": "0.0.0",
  "private": true,
  "description": "Internal sales administration for unit bookings through SPA signing",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,frontend \"bun run --filter server dev\" \"bun run --filter frontend dev\"",
    "build": "bun run --filter frontend build",
    "db:reset": "bun run --filter server db:reset",
    "jev:precompute": "bun run --filter @mortar/jev jev:precompute",
    "lint": "eslint --max-warnings 0",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,mts}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "typescript-eslint": "^8.70.0"
  }
}
