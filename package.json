{
  "name": "hackathon-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack hackathon starter: Next.js, TypeScript, Tailwind, shadcn/ui, Drizzle, Better Auth, AI SDK",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "bun run scripts/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "bunx auth@latest generate --config src/lib/auth-cli.ts --output src/lib/db/auth-schema.ts --yes",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "ui:add": "shadcn add",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.65",
    "@ai-sdk/react": "^4.0.97",
    "@electric-sql/pglite": "^0.5.8",
    "@t3-oss/env-nextjs": "^0.13.11",
    "ai": "^7.0.94",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@next/env": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{ts,tsx,mjs,mts}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  }
}
