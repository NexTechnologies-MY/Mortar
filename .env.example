# Copy this to `.env` at the repo root. It is git-ignored.
# The server reads it through `bun --env-file=../.env`; Vite reads the same file
# via `envDir` in frontend/vite.config.ts.

# Required. The server exits on boot without it (server/src/index.ts).
# Either the Neon dev branch connection string, or a local Postgres:
#   docker run -d --name mortar-pg -e POSTGRES_PASSWORD=mortar \
#     -e POSTGRES_DB=mortar -p 5432:5432 postgres:17-alpine
#   DATABASE_URL=postgres://postgres:mortar@localhost:5432/mortar
# An empty database is fine: the server applies schema.sql and seeds the
# canonical dataset on first boot.
DATABASE_URL=

# Optional. Without it Jev serves the precomputed answers and never calls the
# model; the Settings health card reads "Missing". Ask does not use it at all.
TYPESAFE_API_KEY=

# Optional, and only used when TYPESAFE_API_KEY is unset. Points Jev at a local
# Anthropic-Messages-compatible model proxy (e.g. CLIProxyAPI) instead of the
# TypeSafe API, so Jev can run without a TypeSafe key. WARNING: case data is
# sent as a prompt to whatever model sits behind the proxy — use this only
# with made-up demo data, never with real buyer or booking information.
#   JEV_PROXY_URL=http://127.0.0.1:PORT     — base URL, no trailing /v1/messages
#   JEV_PROXY_KEY=                          — the proxy's x-api-key
#   JEV_PROXY_MODEL=gemini-3.5-flash-lite   — model the proxy should route to (default)
JEV_PROXY_URL=
JEV_PROXY_KEY=
JEV_PROXY_MODEL=

# Optional. The API port. The Vite dev server proxies /api here.
PORT=8787

# Optional. The Vite dev server port.
FRONTEND_PORT=5173
